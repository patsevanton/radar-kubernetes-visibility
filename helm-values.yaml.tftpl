ingress:
  enabled: true
  className: nginx
  hosts:
    - host: ${radar_fqdn}
      paths:
        - path: /
          pathType: Prefix

rbac:
  podLogs: true    # просмотр логов подов (включён по умолчанию)
  podExec: false   # терминал в подах — включайте осознанно
  secrets: false   # чтение Secrets — выключено по умолчанию
  helm: false      # Helm write-операции — выключено по умолчанию

timeline:
  storage: memory

# Prometheus-бэкенд для Traffic-карты, Cost Insights и query_prometheus.
# vmsingle из victoria-metrics-k8s-stack (см. раздел про vmks в README).
traffic:
  prometheusUrl: http://vmsingle-vmks-victoria-metrics-k8s-stack.vmks.svc:8429

resources:
  limits:
    cpu: 500m
    memory: 512Mi
  requests:
    cpu: 100m
    memory: 128Mi
