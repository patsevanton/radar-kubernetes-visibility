grafana:
  ingress:
    ingressClassName: nginx
    enabled: true
    annotations:
      nginx.ingress.kubernetes.io/ssl-redirect: "false"
    hosts:
      - grafana.${ingress_public_ip}.sslip.io

defaultDatasources:
  victoriametrics:
    datasources:
      - name: VictoriaMetrics
        type: prometheus
        access: proxy
        isDefault: true
        jsonData:
          httpMethod: POST
          queryTimeout: 300s
          # Снижает число точек на панель и нагрузку параллельных подзапросов к backend на широких диапазонах.
          timeInterval: 30s

defaultRules:
  groups:
    etcd:
      enabled: false
    kubernetes-system-scheduler:
      enabled: false
    kubernetes-system-controller-manager:
      enabled: false
    # В Yandex Managed K8s kube-scheduler недоступен для скрейпинга,
    # поэтому recording-правила группы kube-scheduler.rules не имеют данных
    # и порождают шумный алерт RecordingRulesNoData.
    kube-scheduler.rules:
      enabled: false
# Control-plane компоненты Yandex Managed K8s (kube-controller-manager, kube-scheduler,
# kube-etcd) недоступны для скрейпинга — master управляемый и вне кластера.
# Отключаем scrape-job, иначе vmagent плодит ScrapePoolHasNoTargets,
# а vmalert — RecordingRulesNoData для пустых scrape-pool.
kubeControllerManager:
  enabled: false
kubeScheduler:
  enabled: false
kubeEtcd:
  enabled: false

# Алерты не ставим: Radar не отображает firing-алерты Alertmanager'а,
# а ресурсов демо-кластера мало. Алерты — в Grafana UI при необходимости.
vmalert:
  enabled: false
alertmanager:
  enabled: false

# Скрейп Caretta (eBPF-агент groundcover, источник данных для Traffic-карты Radar).
# Ставится в namespace caretta с victoria-metrics-single.enabled=false и grafana.enabled=false,
# поэтому собираем его метрики (caretta_links_observed) в общий vmsingle.
# vmagent с selectAllByDefault: true подхватит VMPodScrape из любого namespace.
extraObjects:
  - apiVersion: operator.victoriametrics.com/v1beta1
    kind: VMPodScrape
    metadata:
      name: caretta
      namespace: vmks
      labels:
        managed-by: vmks-victoria-metrics-k8s-stack
    spec:
      selector:
        matchLabels:
          app.kubernetes.io/name: caretta
      namespaceSelector:
        matchNames:
          - caretta
      podMetricsEndpoints:
        - port: prom-metrics
          interval: 15s
